msgid "Missing satellite position in API record: %s"
msgstr "API kaydında uydu konumu eksik: %s"

msgid "Could not match transponder to actual satellite position: %s"
msgstr "Frekansın gerçek uydu konumu eşleştirilemedi: %s"

msgid "Could not read KingOfSat satellite table"
msgstr "KingOfSat uydu tablosu okunamadı"

