msgstr "Tuner listesi yeniden yüklendi."

msgid "Restart Enigma2 to apply the changes."
msgstr "Değişiklik için Enigma2'yi yeniden başlatın."

msgid "Wrote %d satellite positions and %d transponders.\n%s\n%s"
msgstr "%d uydu konumu ve %d transponder yazıldı.\n%s\n%s"

msgid "Backup: %s"
msgstr "Yedek: %s"

msgid "No previous file existed."
msgstr "Önceki dosya yoktu."

msgid "\nSkipped %d positions with no transponders."
msgstr "\nFrekans bulunmayan %d konum atlandı."

msgid "Which site would you like to use?"
msgstr "Hangi siteyi kullanmak istiyorsunuz?"

msgid "Left / Right: select source | OK: continue | EXIT: close"
msgstr "Sol / Sağ: kaynak seç  |  OK: devam  |  EXIT: kapat"

