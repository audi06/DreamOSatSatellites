msgstr "Skin kaydedildi. Eklentiyi kapatıp açınca uygulanır. Boyut, mevcut ekran çözünürlüğüne sığdırılır."

msgid "%d positions found. OK: select/clear | MENU: settings"
msgstr "%d uydu konumu bulundu. OK: seç/kaldır | MENU: ayarlar"

msgid "Error: %s"
msgstr "Hata: %s"

msgid "%d / %d positions selected"
msgstr "%d / %d konum seçildi"

msgid "Select at least one satellite position first."
msgstr "Önce en az bir uydu konumu seçin."

